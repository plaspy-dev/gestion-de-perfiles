IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",              ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "Importar",                    ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Imprimir\tCtrl+P",           57607
        MENUITEM "&Vista Preliminar",           57609
        MENUITEM "C&onfigurar Página",          57606
        MENUITEM SEPARATOR
        MENUITEM "&Administrador",              ID_ARCHIVO_ADMINISTRADOR
        MENUITEM SEPARATOR
        MENUITEM "&Cerrar",                     ID_FILE_CLOSE
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Navegador\tF2",              136
    END
    POPUP "&Herramientas"
    BEGIN
        MENUITEM "&Servidores",                 ID_CONFIGURACION_SERVIDORES
        MENUITEM SEPARATOR
        MENUITEM "&Español",                    ID_HERRAMIENTAS_ESPA32771
        MENUITEM "&German",                     ID_HERRAMIENTAS_GERMAN
        MENUITEM "E&nglish",                    ID_HERRAMIENTAS_ENGLISH
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "Ayuda\tF1",                   ID_HELP_INDEX
        MENUITEM SEPARATOR
        MENUITEM "&Acerca de Perfiles...",     ID_APP_ABOUT
    END
END

IDR_TemplateTYPE MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",              ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Guardar\tCtrl+G",            ID_FILE_SAVE
        MENUITEM SEPARATOR
        MENUITEM "Importar",                    ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Imprimir\tCtrl+P",           57607
        MENUITEM "&Vista Preliminar",           57609
        MENUITEM "C&onfigurar Página",          57606
        MENUITEM SEPARATOR
        MENUITEM "&Administrador",              ID_ARCHIVO_ADMINISTRADOR
        MENUITEM SEPARATOR
        MENUITEM "&Cerrar",                     ID_FILE_CLOSE
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Edición"
    BEGIN
        MENUITEM "&Deshacer\tCtrl+Z",           ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cor&tar\tCtrl+X",             ID_EDIT_CUT
        MENUITEM "&Copiar\tCtrl+C",             ID_EDIT_COPY
        MENUITEM "&Pegar\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Navegador\tF2",              136
    END
    POPUP "&Herramientas"
    BEGIN
        MENUITEM "&Servidores",                 142
        MENUITEM SEPARATOR
        MENUITEM "&Español",                    ID_HERRAMIENTAS_ESPA32771
        MENUITEM "&German",                     ID_HERRAMIENTAS_GERMAN
        MENUITEM "E&nglish",                    ID_HERRAMIENTAS_ENGLISH
    END
    POPUP "&Ventana"
    BEGIN
        MENUITEM "&Cascada",                    ID_WINDOW_CASCADE
        MENUITEM "&Mosaico",                    ID_WINDOW_TILE_HORZ
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "Ayuda\tF1",                   ID_HELP_INDEX
        MENUITEM SEPARATOR
        MENUITEM "&Acerca de Perfiles...",     ID_APP_ABOUT
    END
END


